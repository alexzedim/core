# ==== routing (Caddy + caddy-proxy-manager) ====
# Deployed via Portainer env / ../envs/routing/.stack.env — keep in sync.

# Panel (caddy-proxy-manager web UI, http://128.0.0.255:3000)
CPM_SESSION_SECRET=
CPM_ADMIN_USERNAME=
CPM_ADMIN_PASSWORD=
# API token created in the panel (Settings -> API tokens); used by cert-sync
CPM_API_TOKEN=
CPM_BASE_URL=http://128.0.0.255:3000
CADDY_PRIMARY_DOMAIN=cmnw.me

# cert-sync sidecar (Selectel Certificate Manager -> panel).
# Static API keys are NOT accepted by the CM API — it wants a Keystone
# (Identity v3) project token, so we auth as a Selectel service user
# (name/password below, role `member` on the project) on every run.
# SELECTEL_CERT_ID is the knox id shown in the certificate's UID field.
SELECTEL_USER=cert-sync
SELECTEL_PASSWORD=
SELECTEL_DOMAIN=454323
SELECTEL_PROJECT=cmnw
SELECTEL_CERT_ID=
CERT_SYNC_CERT_NAME=cmnw.ru
CERT_SYNC_CRON=0 6 * * *

# l4-port-manager
L4_POLL_INTERVAL=2

# ==== home (Home Assistant) ====
# Deployed via Portainer env / ../envs/home/.stack.env — keep in sync.

TZ=Europe/Moscow

# ==== git (GitHub Actions runners + GitLab runners) ====
# Deployed via Portainer env / ../envs/git/.stack.env — keep in sync.

# myoung34/github-runner registration (repo/org PAT with repo / admin:org scope)
GITHUB_TOKEN=
# gitlab-runner managers: glrt- token from Admin -> CI/CD -> Runners ->
# "core-gitlab-runner"; consumed on first boot only (config cached in the
# gitlab-runner-*-config volumes) — rotation = re-issue via the runner page,
# update env, drop those volumes, redeploy
GITLAB_RUNNER_TOKEN=
