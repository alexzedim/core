# ==== routing (Caddy + caddy-proxy-manager) ====
# Deployed via Portainer env / ../envs/routing/.stack.env — keep in sync.

# Panel (caddy-proxy-manager web UI, http://128.0.0.255:3000)
CPM_SESSION_SECRET=
CPM_ADMIN_USERNAME=
CPM_ADMIN_PASSWORD=
# API token created in the panel (Settings -> API tokens); used by cert-sync
CPM_API_TOKEN=
CPM_BASE_URL=http://128.0.0.255:3000
CADDY_PRIMARY_DOMAIN=cmnw.me

# cert-sync sidecar (Selectel Certificate Manager -> panel)
# SELECTEL_CERT_ID is the knox id shown in the certificate's UID field
SELECTEL_API_TOKEN=
SELECTEL_CERT_ID=
CERT_SYNC_CERT_NAME=cmnw.ru
CERT_SYNC_CRON=0 6 * * *

# l4-port-manager
L4_POLL_INTERVAL=2
