# ==== routing (Caddy + caddy-proxy-manager) ====
# Deployed via Portainer env / ../envs/routing/.stack.env — keep in sync.

# Panel (caddy-proxy-manager web UI, http://128.0.0.255:3001)
CPM_SESSION_SECRET=
CPM_ADMIN_USERNAME=
CPM_ADMIN_PASSWORD=
# API token created in the panel (Settings -> API tokens); used by cert-sync
CPM_API_TOKEN=
CPM_BASE_URL=http://128.0.0.255:3001
CADDY_PRIMARY_DOMAIN=cmnw.me

# cert-sync sidecar (Selectel Certificate Manager -> panel).
# Static API keys are NOT accepted by the CM API — it wants a Keystone
# (Identity v3) project token, so we auth as a Selectel service user
# (name/password below, role `member` on the project) on every run.
# SELECTEL_CERT_ID is the knox id shown in the certificate's UID field.
SELECTEL_USER=cert-sync
SELECTEL_PASSWORD=
SELECTEL_DOMAIN=454323
SELECTEL_PROJECT=cmnw
SELECTEL_CERT_ID=
CERT_SYNC_CERT_NAME=cmnw.ru
CERT_SYNC_CRON=0 6 * * *

# l4-port-manager
L4_POLL_INTERVAL=2

# ==== home (Home Assistant) ====
# Deployed via Portainer env / ../envs/home/.stack.env — keep in sync.

TZ=Europe/Moscow

# ==== git (GitHub Actions runners + GitLab runners) ====
# Deployed via Portainer env / ../envs/git/.stack.env — keep in sync.

# myoung34/github-runner registration (repo/org PAT with repo / admin:org scope)
GITHUB_TOKEN=
# gitlab-runner managers: glrt- token from Admin -> CI/CD -> Runners ->
# "core-gitlab-runner"; consumed on first boot only (config cached in the
# gitlab-runner-*-config volumes) — rotation = re-issue via the runner page,
# update env, drop those volumes, redeploy
GITLAB_RUNNER_TOKEN=

# ==== gitlab (GitLab CE) ====
# Root password seeds the root user on first boot only; runtime config lives
# in the git_config volume's gitlab.rb (gitignored local mirror:
# gitlab/config/gitlab.rb).
GITLAB_ROOT_PASSWORD=

# ==== network (AdGuard Home + AdGuard VPN gateways) ====
# Deployed as a Portainer Repository stack (public GitHub alexzedim/core,
# master, compose path compose.network.yaml) / ../envs/network/.stack.env —
# keep in sync. The gateways consume VPN_EMAIL/VPN_PASSWORD via
# env_file: stack.env (Portainer writes the stack env there).
# The ${ORACLE_*} bind/port vars keep inline defaults (bind 128.0.0.255;
# ports 6181-6187, 9321-9324, 3478, 49160-49260) — set only if ports move.

TZ=Europe/Moscow

# AdGuard VPN account the gateways log in with (same account as the oracle
# stack; each gateway takes a device slot)
VPN_EMAIL=
VPN_PASSWORD=

# SOCKS5 exposed on every vpn-oracle* gateway for oraculum services
# (socks5h://<user>:<pass>@vpn-oracle-<x>:1080). Applied once per gateway via
# `adguardvpn-cli config set-socks-host 0.0.0.0` + set-socks-username/password
# (persisted in the gateway volume, not read from env) — recorded here and in
# ../envs/network/.stack.env as the source of truth.
VPN_SOCKS_USERNAME=
VPN_SOCKS_PASSWORD=

# ==== storage (PostgreSQL + Redis + MinIO + RabbitMQ + pgvector) ====
# Deployed via Portainer env / ../envs/storage/.stack.env — keep in sync.

POSTGRES_DB=cmnw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

REDIS_PASSWORD=

RABBITMQ_USER=
RABBITMQ_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# LightRAG graph/vector DB (pgvector, :5433); consumed by the pgvector-exporter DSN
LIGHTRAG_PG_USER=lightrag
LIGHTRAG_PG_PASSWORD=
LIGHTRAG_PG_DB=lightrag
PGVECTOR_BIND_IP=128.0.0.255

# ==== analytics (Prometheus + Grafana + Loki) ====
# Deployed via Portainer env / ../envs/analytics/.stack.env — keep in sync.

# postgres_exporter DSN for the MAIN postgres (vanilla :5432, not pgvector)
DATA_SOURCE_NAME=

GF_PATHS_PROVISIONING=/etc/grafana/provisioning
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
GF_FEATURE_TOGGLES_ENABLE=alertingSimplifiedRouting,alertingQueryAndExpressionsStepMode

# MinIO scrape bearer token — `mc admin prometheus generate <alias> cluster`
MINIO_PROMETHEUS_TOKEN=

# Home Assistant long-lived access token for the /api/prometheus scrape
HASS_PROMETHEUS_TOKEN=

# ==== oraculum (indexator + oracular + archivum + gateway + lightrag) ====
# Deployed via Portainer env / ../envs/oraculum/.stack.env — keep in sync.
# Only the vars compose.oraculum.yaml interpolates are listed here, plus the
# lightrag inference set the container reads natively from the stack env
# (values are adapted per stand — no endpoint defaults are committed).

# lightrag REDIS_URL / RABBITMQ_URL (new-style names; the Node apps keep the legacy block)
REDIS_HOST=128.0.0.255
REDIS_PORT=6379
RABBIT_USER=rabbitmq
RABBIT_PASSWORD=
RABBIT_HOST=128.0.0.255
RABBIT_PORT=5672
RABBIT_VHOST=cmnw

# LAN bind IP for the lightrag API port mapping
LIGHTRAG_BIND_IP=128.0.0.255

# lightrag inference — OpenAI-compatible endpoints, no VPN proxy in front.
# The compose pins only the binding TYPES (LLM/EMBEDDING=openai, RERANK=cohere);
# hosts/models/keys all come from the stack env.
LLM_BINDING_HOST=
LLM_BINDING_API_KEY=
LLM_MODEL=
QUERY_LLM_MODEL=
EMBEDDING_BINDING_HOST=
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
RERANK_BINDING_HOST=
RERANK_BINDING_API_KEY=
RERANK_MODEL=

# ==== ai-platform lab (ai-documents + wiki) ====
# Deployed via Portainer env / ../envs/ai-platform/.stack.env — keep in sync.
# Images: rolling :exp aliases from registry.cmnw.ru/ai-platform/* (the
# Portainer Repository stack is this repo's compose.ai-platform.yaml).

# Backend / worker / indexator / frontend (one env for the whole stack)
NODE_ENV=development
LANGUAGE=ru
BACKEND_HOST=0.0.0.0
PORT=2050
# Lab override of the image-baked 12 GB heap cap (env_file wins over ENV).
NODE_OPTIONS=--max-old-space-size=2048
BACKEND_URL=https://ai-documents.cmnw.ru
FRONTEND_URL=https://ai-documents.cmnw.ru
WIKI_URL=https://wiki.cmnw.ru
WIKI_CLIENT_URL=https://wiki.cmnw.ru
COOKIE_SECRET=
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_MAX_SECONDS=36000
SESSIONS_KEY=sid
SNOWFLAKE_EPOCH=1609459200000
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_DATACENTER_ID=1
LOKI_ENDPOINT=http://128.0.0.255:3100
LOKI_ENABLED=true
S3_ENDPOINT=http://128.0.0.255:9000
S3_PRESIGN_ENDPOINT=https://s3.cmnw.ru
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=russia-1
DATABASE_CLIENT=postgres
DATABASE_HOST=128.0.0.255
DATABASE_PORT=5432
DATABASE_NAME=ai-documents-dev
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SYNCRONIZE=true
PGSSL=false
REDIS_HOST=128.0.0.255
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=5
RABBITMQ_URL=
LIGHTRAG_URL=http://128.0.0.255:9621
LIGHTRAG_API_KEY=
LOGIN_MAX_ATTEMPTS=5
LOGIN_TIMEOUT_SECONDS=900
INTERNAL_API_TOKEN=
DOCUMENT_UPLOAD_CONCURRENCY=3
WIKI_UPLOAD_CONCURRENCY=3
DOCUMENT_ANALYSIS_CONCURRENCY=3
DOCUMENT_COMPARE_CONCURRENCY=2
DOCUMENT_CONVERSION_CONCURRENCY=3
AUDIO_TRANSCRIPTION_CONCURRENCY=2
CHAT_CONCURRENCY=20
FF_ENABLE_BPMN=false
FF_S3_SYNC=false
FF_LIGHT_RAG_REUPLOAD=false
FF_ENABLE_PROFILER=false
DEBUG_DUMP_ENABLED=false

# Wiki (shares the same stack env)
APP_URL=https://wiki.cmnw.ru
APP_SECRET=
OCR_ENABLED=true
METRICS_ENABLED=true
DATABASE_URL=postgresql://user:pass@128.0.0.255:5432/wiki?schema=public
REDIS_URL=redis://:pass@128.0.0.255:6379/5
STORAGE_DRIVER=s3
AWS_S3_ENDPOINT=https://s3.cmnw.ru
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=russia-1
AWS_S3_BUCKET=wiki
AWS_S3_FORCE_PATH_STYLE=true
JWT_SESSION_INACTIVE_EXPIRATION=30m
WIKI_LOGIN_MAX_ATTEMPTS=5
WIKI_LOGIN_TIMEOUT_SECONDS=1m
LOKI_METRICS_ENABLED=true
